#include <stdio.h>
#include <stdlib.h>

// Helper function to return the maximum of two integers
int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int *values = (int *)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &values[i]) != 1) return 0;
    }

    int *weights = (int *)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &weights[i]) != 1) return 0;
    }

    int W;
    if (scanf("%d", &W) != 1) return 0;

    // dp[j] will store the maximum value achievable with capacity j
    // Using calloc to automatically initialize all elements to 0
    int *dp = (int *)calloc(W + 1, sizeof(int));

    // Process each item one by one
    for (int i = 0; i < n; i++) {
        // Traverse the DP array backwards to use values from the previous item iteration
        for (int j = W; j >= weights[i]; j--) {
            dp[j] = max(dp[j], dp[j - weights[i]] + values[i]);
        }
    }

    // The last element contains the maximum value for capacity W
    printf("%d\n", dp[W]);

    // Clean up memory
    free(values);
    free(weights);
    free(dp);

    return 0;
}
