#include<stdio.h>
#include<string.h>
#include<stdbool.h>
#define MAX_LENGTH 100

int max(int a, int b){if(a>b){return a;}else{return b;}}

int lcsOf3(char X[], char Y[], char Z[], int m, int n, int o){

    // Trim trailing newlines captured by fgets to avoid length/whitespace padding misma && (X[m - 1] == '\n' || X[m - 1] == '\r')) { m--; }
    while (n > 0 && (Y[n - 1] == '\n' || Y[n - 1] == '\r')) { n--; }
    while (o > 0 && (Z[o - 1] == '\n' || Z[o - 1] == '\r')) { o--; }

    // Dynamically allocate a 3D array to safely avoid stack size limitations
    int ***dp = (int ***)malloc((m + 1) * sizeof(int **));
    for (int i = 0; i <= m; i++) {
        dp[i] = (int **)malloc((n + 1) * sizeof(int *));
        for (int j = 0; j <= n; j++) {
            dp[i][j] = (int *)malloc((o + 1) * sizeof(int));
        }
    }

    // Build the 3D DP table bottom-up
    for (int i = 0; i <= m; i++) {
        for (int j = 0; j <= n; j++) {
            for (int k = 0; k <= o; k++) {
                // Base Case: Any string is empty -> common subsequence length is 0
                if (i == 0 || j == 0 || k == 0) {
                    dp[i][j][k] = 0;
                } 
                // Characters match across all three strings
                else if (X[i - 1] == Y[j - 1] && X[i - 1] == Z[k - 1]) {
                    dp[i][j][k] = dp[i - 1][j - 1][k - 1] + 1;
                } 
                // Characters mismatch -> transition from maximum of three directional shifts
                else {
                    dp[i][j][k] = max(max(dp[i - 1][j][k], dp[i][j - 1][k]), dp[i][j][k - 1]);
                }
            }
        }
    }

    int result = dp[m][n][o];

    // Clean up all allocated memory layers
    for (int i = 0; i <= m; i++) {
        for (int j = 0; j <= n; j++) {
            free(dp[i][j]);
        }
        free(dp[i]);
    }
    free(dp);

    return result;
	
	
	
	
	
}

int main()
{	char x[MAX_LENGTH], y[MAX_LENGTH],z[MAX_LENGTH];
    fgets(x, MAX_LENGTH, stdin);
    fgets(y, MAX_LENGTH, stdin);
    fgets(z, MAX_LENGTH, stdin);
	printf("%d", lcsOf3(x, y, z, strlen(x), strlen(y), strlen(z)));
	
	return 0;
}
