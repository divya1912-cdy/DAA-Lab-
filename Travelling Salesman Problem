#include <stdio.h>
#include <limits.h>

#define MAX_CITIES 16
#define INF 1e9 // Using a large value to represent infinity avoiding overflow

int n;
int dist[MAX_CITIES][MAX_CITIES];
int dp[1 << MAX_CITIES][MAX_CITIES];

// Helper function to find the minimum of two integers
int min(int a, int b) {
    return (a < b) ? a : b;
}

// TSP using Top-Down Dynamic Programming with Bitmasking
int tsp(int mask, int pos) {
    // If all cities have been visited, return the cost to go back to the starting city (0)
    if (mask == (1 << n) - 1) {
        return (dist[pos][0] == -1) ? INF : dist[pos][0];
    }

    // Return the cached result if already calculated
    if (dp[mask][pos] != -1) {
        return dp[mask][pos];
    }

    int ans = INF;

    // Try visiting every other unvisited city
    for (int nxt = 0; nxt < n; nxt++) {
        // Check if the city 'nxt' is not visited and there is a valid path to it
        if ((mask & (1 << nxt)) == 0 && dist[pos][nxt] != -1) {
            int newCost = dist[pos][nxt] + tsp(mask | (1 << nxt), nxt);
            ans = min(ans, newCost);
        }
